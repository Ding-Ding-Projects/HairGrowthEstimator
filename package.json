{
  "name": "hair-growth-estimator",
  "version": "1.0.0",
  "description": "Estimate hair growth, reset projections after haircuts, and synchronize with an optional private LAN service.",
  "main": "app/main.js",
  "author": "Ding Ding Projects",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "prepare:release": "node scripts/release/release-context.mjs",
    "generate:provenance": "node scripts/core/generate-provenance.mjs",
    "generate:icons": "node scripts/core/generate-icons.mjs",
    "verify:icons": "node scripts/core/generate-icons.mjs --verify",
    "generate:build-config": "node scripts/release/build-config.mjs",
    "start": "electron .",
    "start:server": "node server/index.js",
    "pretest": "npm run verify:icons",
    "test": "node --test tests/core/*.test.js && npm run validate:assets && npm run validate:inventory",
    "test:core": "node --test tests/core/*.test.js",
    "validate:assets": "node scripts/core/validate-hair-assets.mjs",
    "validate:inventory": "node scripts/core/check-universal-inventory.mjs",
    "count-lines": "node scripts/core/count-lines.mjs",
    "finalize:run": "node scripts/release/finalize-run.mjs",
    "validate:release-workflow": "node scripts/release/workflow-contract.mjs",
    "validate:container": "node scripts/release/container-contract.mjs",
    "build:container": "node scripts/release/build-container.mjs",
    "test:packaging": "node --test scripts/release/tests/*.test.mjs",
    "prepack": "npm run prepare:release && npm run generate:provenance && npm run verify:icons && npm run generate:build-config",
    "package:dir": "npm run prepack && electron-builder --dir --win --x64 --config dist/build-config/electron-builder.json",
    "dist": "npm run prepack && electron-builder --win squirrel --x64 --config dist/build-config/electron-builder.json"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "resedit": "1.7.2",
    "sharp": "0.34.3"
  },
  "releasePolicy": {
    "forceCodeSigning": false,
    "signExecutable": false,
    "signAndEditExecutable": false,
    "installerFamily": "Squirrel.Windows",
    "platform": "Windows"
  },
  "build": {
    "appId": "com.dingdingprojects.hairgrowthestimator",
    "productName": "Hair Growth Estimator",
    "forceCodeSigning": false,
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      {
        "from": ".",
        "to": ".",
        "filter": [
          "app/**/*",
          "!app/provenance.json",
          "!app/release-metadata.json",
          "assets/**/*"
        ]
      },
      {
        "from": "dist/package-input",
        "to": ".",
        "filter": [
          "package.json",
          "app/provenance.json",
          "app/release-metadata.json"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/app-icon.ico",
      "forceCodeSigning": false,
      "signExecutable": false,
      "signAndEditExecutable": false
    },
    "squirrelWindows": {
      "artifactName": "HairGrowthEstimator-Setup-${version}-${arch}.${ext}",
      "msi": false
    }
  }
}
